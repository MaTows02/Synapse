<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Synapse.Infrastructure.Tests" />
    </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Synapse.Core\Synapse.Core.csproj" />
    <ProjectReference Include="..\WindowsPackageManager.Interop\WindowsPackageManager.Interop.csproj" />
  </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Management" Version="8.0.0" />
        <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
        <PackageReference Include="System.DirectoryServices.Protocols" Version="8.0.0" />
        <PackageReference Include="System.IO.Packaging" Version="8.0.1" />
        <PackageReference Include="Microsoft.Windows.Compatibility" Version="8.0.10" />
        <!-- Pin the current patched servicing release so transitive compatibility
             packages cannot select a vulnerable version. -->
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    </ItemGroup>

  <ItemGroup>
    <None Include="Features\SoftwareApps\Services\WinGet\winget-cli\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>winget-cli\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
</Project>
