<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Synapse.UI.Features.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,24,28,36" Spacing="18">
            <Border CornerRadius="18" Padding="28" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="18" Background="#1835C7F4">
                        <Image Source="ms-appx:///Assets/AppIcons/Synapse-rocket-white-transparent-bg.png" Width="40" Height="40"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                        <TextBlock Text="Tableau de bord" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="Bienvenue dans Synapse. Les outils Game Booster, Matériel, Nettoyage profond, Santé système et Gestionnaire des tâches sont maintenant accessibles directement sous Personnaliser." TextWrapping="Wrap" Opacity="0.65"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="Accès rapides" FontSize="20" FontWeight="SemiBold"/>
            <Grid ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Padding="18" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="7"><FontIcon Glyph="&#xE7FC;" FontSize="24" Foreground="#FF35C7F4"/><TextBlock Text="Game Booster" FontWeight="SemiBold"/><TextBlock Text="Profils de jeu et réduction des tâches en arrière-plan." TextWrapping="Wrap" Opacity="0.6"/></StackPanel></Border>
                <Border Grid.Column="1" Padding="18" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="7"><FontIcon Glyph="&#xE950;" FontSize="24" Foreground="#FF21D487"/><TextBlock Text="Matériel" FontWeight="SemiBold"/><TextBlock Text="Composants, réseau, technologies et contrôleurs." TextWrapping="Wrap" Opacity="0.6"/></StackPanel></Border>
                <Border Grid.Column="2" Padding="18" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="7"><FontIcon Glyph="&#xE95E;" FontSize="24" Foreground="#FFFFB44A"/><TextBlock Text="Santé système" FontWeight="SemiBold"/><TextBlock Text="Diagnostics Windows et recommandations exploitables." TextWrapping="Wrap" Opacity="0.6"/></StackPanel></Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
