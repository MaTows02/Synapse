<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Synapse.UI.Features.ControlCenter.ControlCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Synapse.Core.Features.ControlCenter.Models"
    xmlns:controls="using:Synapse.UI.Features.Common.Controls"
    Background="Transparent">

    <Page.Resources>
        <SolidColorBrush x:Key="SynapseCyanBrush" Color="#FF35C7F4"/>
        <SolidColorBrush x:Key="SynapseGreenBrush" Color="#FF21D487"/>
        <SolidColorBrush x:Key="SynapseAmberBrush" Color="#FFFFB44A"/>
        <SolidColorBrush x:Key="SynapseRedBrush" Color="#FFFF5D6C"/>
        <SolidColorBrush x:Key="SoftCyanBrush" Color="#1835C7F4"/>
        <SolidColorBrush x:Key="SoftGreenBrush" Color="#1821D487"/>
        <SolidColorBrush x:Key="SoftAmberBrush" Color="#18FFB44A"/>
        <SolidColorBrush x:Key="SoftRedBrush" Color="#18FF5D6C"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="24"/>
            <Setter Property="MinHeight" Value="132"/>
        </Style>
        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="MinHeight" Value="126"/>
        </Style>
        <Style x:Key="ActionRowStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="FlowCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="MinHeight" Value="82"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="120"/>
            <Setter Property="Foreground" Value="{StaticResource SynapseCyanBrush}"/>
        </Style>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.64"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CategoryNavigationItemStyle" TargetType="NavigationViewItem">
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Margin" Value="7,3"/>
        </Style>
        <Style x:Key="CleanupOptionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </Page.Resources>

    <NavigationView
        x:Name="CategoryNavigationView"
        AlwaysShowHeader="False"
        Background="Transparent"
        CompactPaneLength="0"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="False"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="0"
        PaneDisplayMode="LeftMinimal"
        Loaded="CategoryNavigationView_Loaded"
        SelectionChanged="CategoryNavigationView_SelectionChanged">

        <NavigationView.PaneHeader>
            <StackPanel Margin="14,18,14,14" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource SoftCyanBrush}">
                        <Image Source="{ThemeResource SynapseMonochromeLogo}" Width="24" Height="24"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SYNAPSE" FontSize="18" FontWeight="Bold" CharacterSpacing="120"/>
                        <TextBlock Text="CONTROL CENTER" FontSize="10" Opacity="0.55" CharacterSpacing="90"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Margin="0,16,0,0" Text="CATÉGORIES" FontSize="11" FontWeight="SemiBold" Opacity="0.5" CharacterSpacing="120"/>
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Tag="GameBooster" Style="{StaticResource CategoryNavigationItemStyle}" AutomationProperties.Name="Game Booster">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;"/></NavigationViewItem.Icon>
                <StackPanel>
                    <TextBlock Text="Game Booster" FontWeight="SemiBold"/>
                    <TextBlock Text="Jeux et performances" FontSize="11" Opacity="0.55"/>
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="Hardware" Style="{StaticResource CategoryNavigationItemStyle}" AutomationProperties.Name="Matériel">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE950;"/></NavigationViewItem.Icon>
                <StackPanel>
                    <TextBlock Text="Matériel" FontWeight="SemiBold"/>
                    <TextBlock Text="Composants et contrôle" FontSize="11" Opacity="0.55"/>
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="DeepCleanup" Style="{StaticResource CategoryNavigationItemStyle}" AutomationProperties.Name="Nettoyage profond">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;"/></NavigationViewItem.Icon>
                <StackPanel>
                    <TextBlock Text="Nettoyage profond" FontWeight="SemiBold"/>
                    <TextBlock Text="Fichiers et applications" FontSize="11" Opacity="0.55"/>
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="SystemHealth" Style="{StaticResource CategoryNavigationItemStyle}" AutomationProperties.Name="Santé système">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE95E;"/></NavigationViewItem.Icon>
                <StackPanel>
                    <TextBlock Text="Santé système" FontWeight="SemiBold"/>
                    <TextBlock Text="Diagnostics et conseils" FontSize="11" Opacity="0.55"/>
                </StackPanel>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <StackPanel Margin="14,12,14,18" Spacing="8">
                <Border CornerRadius="12" Padding="12" Background="{StaticResource SoftGreenBrush}" BorderBrush="#4021D487" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="● PROTECTION ACTIVE" Foreground="{StaticResource SynapseGreenBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="Les actions sensibles créent un point de restauration." FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Documentation" FontSize="11" Click="OpenDocumentationButton_Click"/>
                    <Button Content="Support" FontSize="11" Click="OpenSupportButton_Click"/>
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneFooter>

        <Grid Padding="22,18,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <InfoBar x:Name="OverviewInfo" IsOpen="False" IsClosable="True" Margin="0,0,0,12"/>

            <Grid Grid.Row="1">
                <Grid x:Name="GameBoosterView" x:Load="False">
                    <ScrollViewer x:Name="GameBoosterScrollViewer" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Padding="0,0,6,18">
                            <Border Style="{StaticResource HeroCardStyle}" Padding="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#301681B8" Offset="0"/>
                                        <GradientStop Color="#18122A48" Offset="0.55"/>
                                        <GradientStop Color="#1421D487" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Padding="26" ColumnSpacing="18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="GAME BOOSTER V3" Style="{StaticResource EyebrowStyle}"/>
                                        <TextBlock Text="Un profil propre, mesurable et réversible." Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="Synapse prépare Windows au lancement du jeu, estime les ressources récupérables et restaure chaque action à la fermeture." Style="{StaticResource MutedTextStyle}" MaxWidth="780"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="18" Padding="14,9" Background="{StaticResource SoftGreenBrush}" BorderBrush="#5021D487" BorderThickness="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE73E;" Foreground="{StaticResource SynapseGreenBrush}" FontSize="16"/>
                                            <TextBlock x:Name="BoosterEngineStatusText" Text="Moteur prêt" Foreground="{StaticResource SynapseGreenBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="PROFIL INTELLIGENT" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" Opacity="0.55"/>
                                            <TextBlock Text="Choisis ton objectif" Style="{StaticResource SectionTitleStyle}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="BoosterPresetStatusText" Text="Équilibré · recommandé" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SynapseCyanBrush}"/>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Tag="Balanced" Click="BoosterPresetButton_Click" HorizontalContentAlignment="Stretch" Padding="16">
                                            <StackPanel Spacing="4"><TextBlock Text="ÉQUILIBRÉ" FontWeight="SemiBold"/><TextBlock Text="Priorité élevée, actions recommandées, consommation maîtrisée." FontSize="11" Opacity="0.58" TextWrapping="Wrap"/></StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Tag="Competitive" Click="BoosterPresetButton_Click" HorizontalContentAlignment="Stretch" Padding="16">
                                            <StackPanel Spacing="4"><TextBlock Text="COMPÉTITIF" FontWeight="SemiBold"/><TextBlock Text="Timer 0,5 ms, plan performances et priorité élevée." FontSize="11" Opacity="0.58" TextWrapping="Wrap"/></StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Tag="Eco" Click="BoosterPresetButton_Click" HorizontalContentAlignment="Stretch" Padding="16">
                                            <StackPanel Spacing="4"><TextBlock Text="ÉCO / PORTABLE" FontWeight="SemiBold"/><TextBlock Text="Aucun timer forcé, plan Windows conservé, moins de chaleur." FontSize="11" Opacity="0.58" TextWrapping="Wrap"/></StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid Padding="18,16">
                                            <StackPanel>
                                                <TextBlock Text="BIBLIOTHÈQUE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" Opacity="0.55"/>
                                                <TextBlock Text="Jeux détectés" Style="{StaticResource SectionTitleStyle}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="Ajouter" Click="AddManualGameButton_Click" ToolTipService.ToolTip="Choisir manuellement le fichier .exe d’un jeu."/>
                                                <Button Content="Analyser" Click="ScanGamesButton_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <ListView x:Name="GamesList" Grid.Row="1" MinHeight="440" SelectionMode="Single" SelectionChanged="GamesList_SelectionChanged">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:DetectedGame">
                                                    <Grid Padding="12" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <controls:ExecutableIcon ExecutablePath="{x:Bind ExecutablePath}" Width="42" Height="42"/>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{x:Bind Launcher}" Opacity="0.58" FontSize="12"/>
                                                            <TextBlock Text="{x:Bind OptimizationSummary}" Opacity="0.5" FontSize="11" TextWrapping="Wrap" MaxLines="2"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock x:Name="GameStatusText" Grid.Row="2" Margin="18" Text="Steam, Epic, jeux enregistrés dans Windows et exécutables ajoutés manuellement." TextWrapping="Wrap" Opacity="0.62"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="14">
                                    <Border Style="{StaticResource CardStyle}">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <controls:ExecutableIcon x:Name="SelectedGameIcon" Width="56" Height="56"/>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock x:Name="SelectedGameNameText" Text="Sélectionne un jeu" FontSize="24" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="SelectedGamePathText" Text="Le profil s’activera automatiquement au lancement." Style="{StaticResource MutedTextStyle}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Enregistrer et activer" Style="{StaticResource AccentButtonStyle}" Click="CreateGameProfileButton_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="ACTIONS DE SESSION" Style="{StaticResource SectionTitleStyle}"/>
                                                <Border Style="{StaticResource ActionRowStyle}"><ToggleSwitch x:Name="GameHighPriorityToggle" IsOn="True" Header="Priorité CPU élevée" OffContent="Standard" OnContent="Élevée"/></Border>
                                                <Border Style="{StaticResource ActionRowStyle}"><ToggleSwitch x:Name="GamePowerPlanToggle" Header="Plan hautes performances" OffContent="Plan actuel" OnContent="Performances"/></Border>
                                                <Border Style="{StaticResource ActionRowStyle}"><ToggleSwitch x:Name="GameTimerToggle" Header="Timer basse latence (0,5 ms)" OffContent="Normal" OnContent="Actif"/></Border>
                                                <Border Style="{StaticResource ActionRowStyle}"><ToggleSwitch x:Name="GameKeepAwakeToggle" IsOn="True" Header="Empêcher la veille pendant la partie" OffContent="Non" OnContent="Oui"/></Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="12">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="IMPACT AVANT LANCEMENT" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" Opacity="0.55"/>
                                                        <TextBlock Text="Applications d’arrière-plan" Style="{StaticResource SectionTitleStyle}"/>
                                                    </StackPanel>
                                                    <Button Content="Actualiser" HorizontalAlignment="Right" Click="RefreshBoosterCandidatesButton_Click"/>
                                                </Grid>
                                                <ComboBox x:Name="BoosterActionPicker" Header="Action" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="Mettre en pause — réversible et recommandé"/>
                                                    <ComboBoxItem Content="Fermer — peut perdre des données"/>
                                                </ComboBox>
                                                <ListView x:Name="BoosterProcessesList" Height="265" SelectionMode="Multiple" SelectionChanged="BoosterProcessesList_SelectionChanged">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="models:BoosterCandidateInfo">
                                                            <Grid Padding="8" ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <controls:ExecutableIcon ExecutablePath="{x:Bind ExecutablePath}" Width="34" Height="34"/>
                                                                <StackPanel Grid.Column="1"><TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Description}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis"/></StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{x:Bind State}" FontSize="11" Foreground="{StaticResource SynapseGreenBrush}" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                                <TextBlock x:Name="BoosterImpactText" Text="Aucune application sélectionnée." FontWeight="SemiBold" Foreground="{StaticResource SynapseGreenBrush}"/>
                                                <TextBlock x:Name="BoosterCandidateStatusText" Text="Lecture des applications en cours…" FontSize="11" Opacity="0.58" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource CardStyle}">
                                        <Grid ColumnSpacing="18">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="9">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Width="38" Height="38" CornerRadius="10" Background="#1876B900"><FontIcon Glyph="&#xE7F8;" Foreground="#FF76B900"/></Border>
                                                    <StackPanel>
                                                        <TextBlock Text="NVIDIA APP CENTER" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" Opacity="0.55"/>
                                                        <TextBlock Text="Pilote, DLSS et performances GPU" Style="{StaticResource SectionTitleStyle}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock x:Name="NvidiaAppStatusText" Text="Détection de NVIDIA App…" TextWrapping="Wrap" Opacity="0.68"/>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource FlowCardStyle}"><StackPanel><TextBlock Text="DLSS Override" FontWeight="SemiBold"/><TextBlock Text="Qualité / FPS par jeu" FontSize="11" Opacity="0.55"/></StackPanel></Border>
                                                    <Border Grid.Column="1" Style="{StaticResource FlowCardStyle}"><StackPanel><TextBlock Text="Smooth Motion" FontWeight="SemiBold"/><TextBlock Text="RTX 40/50 compatible" FontSize="11" Opacity="0.55"/></StackPanel></Border>
                                                    <Border Grid.Column="2" Style="{StaticResource FlowCardStyle}"><StackPanel><TextBlock Text="Auto Tuning" FontWeight="SemiBold"/><TextBlock Text="Scan GPU officiel" FontSize="11" Opacity="0.55"/></StackPanel></Border>
                                                    <Border Grid.Column="3" Style="{StaticResource FlowCardStyle}"><StackPanel><TextBlock Text="Overlay" FontWeight="SemiBold"/><TextBlock Text="FPS, latence, capture" FontSize="11" Opacity="0.55"/></StackPanel></Border>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                                <Button x:Name="OpenNvidiaAppButton" Content="Ouvrir NVIDIA App" Style="{StaticResource AccentButtonStyle}" Click="OpenNvidiaAppButton_Click"/>
                                                <Button Content="Guide officiel" Click="OpenNvidiaGuideButton_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="PROTECTION ET LATENCE" Style="{StaticResource SectionTitleStyle}"/>
                                                <StackPanel Spacing="3"><ToggleSwitch x:Name="LowLatencyToggle" Header="Timer global à 0,5 ms" OffContent="Désactivé" OnContent="Actif" Toggled="LowLatencyToggle_Toggled"/><TextBlock Text="Réglage manuel temporaire. Le profil de jeu est préférable car il restaure automatiquement Windows." FontSize="11" Opacity="0.58" TextWrapping="Wrap"/></StackPanel>
                                                <StackPanel Spacing="3"><ToggleSwitch x:Name="TelemetryToggle" Header="Bouclier anti-télémétrie" OffContent="Désactivé" OnContent="Actif" Toggled="TelemetryToggle_Toggled"/><TextBlock Text="Crée un point de restauration avant toute modification persistante." FontSize="11" Opacity="0.58" TextWrapping="Wrap"/></StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="10">
                                                <Grid>
                                                    <StackPanel><TextBlock Text="OPTIMISATIONS DU JEU" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" Opacity="0.55"/><TextBlock Text="Configuration reconnue" Style="{StaticResource SectionTitleStyle}"/></StackPanel>
                                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="7"><Button Content="Relire" Click="RefreshGameTuningsButton_Click"/><Button Content="Restaurer" Click="RestoreGameTuningsButton_Click"/><Button Content="Appliquer" Style="{StaticResource AccentButtonStyle}" Click="ApplyGameTuningsButton_Click"/></StackPanel>
                                                </Grid>
                                                <InfoBar x:Name="GameTuningInfo" IsOpen="True" IsClosable="False" Severity="Informational" Title="Détection prudente" Message="Sélectionne un jeu : seules les clés déjà présentes dans un fichier reconnu seront proposées."/>
                                                <StackPanel x:Name="GameTuningsPanel" Spacing="8"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="HardwareView" x:Load="False" Visibility="Collapsed">
                    <ScrollViewer x:Name="HardwareScrollViewer" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Padding="0,0,6,18">
                            <Border Style="{StaticResource HeroCardStyle}" Padding="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#291B6B83" Offset="0"/>
                                        <GradientStop Color="#151A2632" Offset="0.55"/>
                                        <GradientStop Color="#1823C8FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Padding="24">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="MATÉRIEL" Style="{StaticResource EyebrowStyle}"/>
                                        <TextBlock Text="Ton PC, clairement." Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="Charge en temps réel, composants, pilotes, technologies Windows, refroidissement et RGB dans une seule vue." Style="{StaticResource MutedTextStyle}" MaxWidth="760"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                                        <Border CornerRadius="16" Padding="12,6" Background="{StaticResource SoftCyanBrush}">
                                            <TextBlock x:Name="LiveStatusText" Text="● INITIALISATION" Foreground="{StaticResource SynapseCyanBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Button Content="Actualiser le matériel" HorizontalAlignment="Stretch" Click="RefreshHardwareButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <StackPanel><TextBlock Text="SYSTÈME" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" Opacity="0.55"/><TextBlock x:Name="OperatingSystemText" Text="Windows" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="OperatingSystemVersionText" Text="Version en cours de lecture" FontSize="12" Opacity="0.55"/></StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="42" Height="42" CornerRadius="12" Background="{StaticResource SoftCyanBrush}"><FontIcon Glyph="&#xE770;" Foreground="{StaticResource SynapseCyanBrush}" FontSize="21"/></Border>
                                    </Grid>
                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Style="{StaticResource ActionRowStyle}"><StackPanel><TextBlock x:Name="OsBuildText" Text="—" FontWeight="SemiBold"/><TextBlock Text="Build" FontSize="11" Opacity="0.5"/></StackPanel></Border>
                                        <Border Grid.Column="1" Style="{StaticResource ActionRowStyle}"><StackPanel><TextBlock x:Name="OsArchitectureText" Text="—" FontWeight="SemiBold"/><TextBlock Text="Architecture" FontSize="11" Opacity="0.5"/></StackPanel></Border>
                                        <Border Grid.Column="2" Style="{StaticResource ActionRowStyle}"><StackPanel><TextBlock x:Name="ComputerNameText" Text="—" FontWeight="SemiBold"/><TextBlock Text="Nom du PC" FontSize="11" Opacity="0.5"/></StackPanel></Border>
                                        <Border Grid.Column="3" Style="{StaticResource ActionRowStyle}"><StackPanel><TextBlock x:Name="UserNameText" Text="—" FontWeight="SemiBold"/><TextBlock Text="Utilisateur" FontSize="11" Opacity="0.5"/></StackPanel></Border>
                                        <Border Grid.Row="1" Style="{StaticResource ActionRowStyle}"><StackPanel><TextBlock x:Name="InstalledDateText" Text="—" FontWeight="SemiBold"/><TextBlock Text="Installation" FontSize="11" Opacity="0.5"/></StackPanel></Border>
