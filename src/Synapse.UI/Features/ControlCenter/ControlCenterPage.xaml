<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Synapse.UI.Features.ControlCenter.ControlCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Synapse.Core.Features.ControlCenter.Models"
    xmlns:controls="using:Synapse.UI.Features.Common.Controls"
    Background="Transparent">

    <Page.Resources>
        <SolidColorBrush x:Key="SynapseCyanBrush" Color="#FF35C7F4"/>
        <SolidColorBrush x:Key="SynapseGreenBrush" Color="#FF21D487"/>
        <SolidColorBrush x:Key="SynapseAmberBrush" Color="#FFFFB44A"/>
        <SolidColorBrush x:Key="SynapseRedBrush" Color="#FFFF5D6C"/>
        <SolidColorBrush x:Key="SoftCyanBrush" Color="#1835C7F4"/>
        <SolidColorBrush x:Key="SoftGreenBrush" Color="#1821D487"/>
        <SolidColorBrush x:Key="SoftAmberBrush" Color="#18FFB44A"/>
        <SolidColorBrush x:Key="SoftRedBrush" Color="#18FF5D6C"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="24"/>
            <Setter Property="MinHeight" Value="132"/>
        </Style>
        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="MinHeight" Value="126"/>
        </Style>
        <Style x:Key="ActionRowStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="FlowCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="MinHeight" Value="82"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="120"/>
            <Setter Property="Foreground" Value="{StaticResource SynapseCyanBrush}"/>
        </Style>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.64"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CategoryNavigationItemStyle" TargetType="NavigationViewItem">
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Margin" Value="7,3"/>
        </Style>
        <Style x:Key="CleanupOptionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </Page.Resources>

    <NavigationView
        x:Name="CategoryNavigationView"
        AlwaysShowHeader="False"
        Background="Transparent"
        CompactPaneLength="0"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="False"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="0"
        PaneDisplayMode="LeftMinimal"
        Loaded="CategoryNavigationView_Loaded"
        SelectionChanged="CategoryNavigationView_SelectionChanged">

        <NavigationView.PaneHeader>
            <StackPanel Margin="14,18,14,14" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource SoftCyanBrush}">
                        <Image Source="ms-appx:///Assets/AppIcons/Synapse-rocket-white-transparent-bg.png" Width="24" Height="24"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SYNAPSE" FontSize="18" FontWeight="Bold" CharacterSpacing="120"/>
                        <TextBlock Text="CONTROL CENTER" FontSize="10" Opacity="0.55" CharacterSpacing="90"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Margin="0,16,0,0" Text="CATÉGORIES" FontSize="11" FontWeight="SemiBold" Opacity="0.5" CharacterSpacing="120"/>
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Tag="GameBooster" Style="{StaticResource CategoryNavigationItemStyle}" AutomationProperties.Name="Game Booster">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;"/></NavigationViewItem.Icon>
                <StackPanel>
                    <TextBlock Text="Game Booster" FontWeight="SemiBold"/>
                    <TextBlock Text="Jeux et performances" FontSize="11" Opacity="0.55"/>
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="Hardware" Style="{StaticResource CategoryNavigationItemStyle}" AutomationProperties.Name="Matériel">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE950;"/></NavigationViewItem.Icon>
                <StackPanel>
                    <TextBlock Text="Matériel" FontWeight="SemiBold"/>
                    <TextBlock Text="Composants et contrôle" FontSize="11" Opacity="0.55"/>
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="DeepCleanup" Style="{StaticResource CategoryNavigationItemStyle}" AutomationProperties.Name="Nettoyage profond">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;"/></NavigationViewItem.Icon>
                <StackPanel>
                    <TextBlock Text="Nettoyage profond" FontWeight="SemiBold"/>
                    <TextBlock Text="Fichiers et applications" FontSize="11" Opacity="0.55"/>
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="SystemHealth" Style="{StaticResource CategoryNavigationItemStyle}" AutomationProperties.Name="Santé système">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE95E;"/></NavigationViewItem.Icon>
                <StackPanel>
                    <TextBlock Text="Santé système" FontWeight="SemiBold"/>
                    <TextBlock Text="Diagnostics et conseils" FontSize="11" Opacity="0.55"/>
                </StackPanel>
            </NavigationViewItem>
            <NavigationViewItem Tag="TaskManager" Style="{StaticResource CategoryNavigationItemStyle}" AutomationProperties.Name="Gestionnaire des tâches">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon>
                <StackPanel>
                    <TextBlock Text="Gestionnaire des tâches" FontWeight="SemiBold"/>
                    <TextBlock Text="Processus, apps et services" FontSize="11" Opacity="0.55"/>
                </StackPanel>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <StackPanel Margin="14,12,14,18" Spacing="8">
                <Border CornerRadius="12" Padding="12" Background="{StaticResource SoftGreenBrush}" BorderBrush="#4021D487" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="● PROTECTION ACTIVE" Foreground="{StaticResource SynapseGreenBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="Les actions sensibles créent un point de restauration." FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Documentation" FontSize="11" Click="OpenDocumentationButton_Click"/>
                    <Button Content="Support" FontSize="11" Click="OpenSupportButton_Click"/>
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneFooter>

        <Grid Padding="22,18,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <InfoBar x:Name="OverviewInfo" IsOpen="False" IsClosable="True" Margin="0,0,0,12"/>

            <Grid Grid.Row="1">
                <Grid x:Name="GameBoosterView" x:Load="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Padding="0,0,6,18">
                            <Border Style="{StaticResource HeroCardStyle}" Padding="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2B087EA4" Offset="0"/>
                                        <GradientStop Color="#160E3445" Offset="0.55"/>
                                        <GradientStop Color="#1021D487" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Padding="24" ColumnSpacing="18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="GAME BOOSTER" Style="{StaticResource EyebrowStyle}"/>
                                        <TextBlock Text="Plus de ressources pour ton jeu." Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="Synapse détecte le lancement, applique uniquement ton profil et restaure Windows à la fermeture." Style="{StaticResource MutedTextStyle}" MaxWidth="760"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="18" Padding="14,8" Background="{StaticResource SoftGreenBrush}" BorderBrush="#5021D487" BorderThickness="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE73E;" Foreground="{StaticResource SynapseGreenBrush}" FontSize="16"/>
                                            <TextBlock Text="Moteur prêt" Foreground="{StaticResource SynapseGreenBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid Padding="18,16">
                                            <StackPanel>
                                                <TextBlock Text="TES JEUX" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" Opacity="0.55"/>
                                                <TextBlock Text="Bibliothèque détectée" Style="{StaticResource SectionTitleStyle}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="Ajouter un jeu" Click="AddManualGameButton_Click" ToolTipService.ToolTip="Choisir manuellement un fichier .exe, par exemple FiveM.exe."/>
                                                <Button Content="Analyser" Click="ScanGamesButton_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <ListView x:Name="GamesList" Grid.Row="1" MinHeight="430" SelectionMode="Single" SelectionChanged="GamesList_SelectionChanged">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:DetectedGame">
                                                    <Grid Padding="12" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <controls:ExecutableIcon ExecutablePath="{x:Bind ExecutablePath}" Width="42" Height="42"/>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{x:Bind Launcher}" Opacity="0.58" FontSize="12"/>
                                                            <TextBlock Text="{x:Bind OptimizationSummary}" Opacity="0.5" FontSize="11" TextWrapping="Wrap" MaxLines="2"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock x:Name="GameStatusText" Grid.Row="2" Margin="18" Text="Analyse automatique de Steam, Epic et des applications enregistrées." TextWrapping="Wrap" Opacity="0.62"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="14">
                                    <Border Style="{StaticResource CardStyle}">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <controls:ExecutableIcon x:Name="SelectedGameIcon" Width="54" Height="54"/>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock x:Name="SelectedGameNameText" Text="Sélectionne un jeu" FontSize="24" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="SelectedGamePathText" Text="Le profil s’active automatiquement au lancement du processus détecté." Style="{StaticResource MutedTextStyle}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Enregistrer le profil" Style="{StaticResource AccentButtonStyle}" Click="CreateGameProfileButton_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="12">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="MODE JEU AUTOMATIQUE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" Opacity="0.55"/>
                                                    <TextBlock Text="Ce qui se passe quand tu joues" Style="{StaticResource SectionTitleStyle}"/>
                                                </StackPanel>
                                                <TextBlock Text="Actions réversibles" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SynapseGreenBrush}"/>
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource FlowCardStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <FontIcon Glyph="&#xE768;" FontSize="20" Foreground="{StaticResource SynapseCyanBrush}"/>
                                                        <StackPanel><TextBlock Text="Jeu lancé" FontWeight="SemiBold"/><TextBlock Text="Détection automatique" FontSize="12" Opacity="0.55"/></StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <FontIcon Grid.Column="1" Glyph="&#xE72A;" Margin="4" VerticalAlignment="Center" Opacity="0.45"/>
                                                <Border Grid.Column="2" Style="{StaticResource FlowCardStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="{StaticResource SynapseGreenBrush}"/>
                                                        <StackPanel><TextBlock Text="Profil appliqué" FontWeight="SemiBold"/><TextBlock Text="CPU, énergie et processus" FontSize="12" Opacity="0.55"/></StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <FontIcon Grid.Column="3" Glyph="&#xE72A;" Margin="4" VerticalAlignment="Center" Opacity="0.45"/>
                                                <Border Grid.Column="4" Style="{StaticResource FlowCardStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <FontIcon Glyph="&#xE8FB;" FontSize="20" Foreground="{StaticResource SynapseCyanBrush}"/>
                                                        <StackPanel><TextBlock Text="Jeu fermé" FontWeight="SemiBold"/><TextBlock Text="Windows restauré" FontSize="12" Opacity="0.55"/></StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <Grid ColumnSpacing="10" RowSpacing="10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Border Style="{StaticResource ActionRowStyle}"><ToggleSwitch x:Name="GameHighPriorityToggle" IsOn="True" Header="Priorité CPU élevée" OffContent="Désactivée" OnContent="Active"/></Border>
                                                <Border Grid.Column="1" Style="{StaticResource ActionRowStyle}"><ToggleSwitch x:Name="GamePowerPlanToggle" Header="Plan hautes performances" OffContent="Désactivé" OnContent="Actif"/></Border>
                                                <Border Grid.Row="1" Style="{StaticResource ActionRowStyle}"><StackPanel Spacing="4"><ToggleSwitch x:Name="GameTimerToggle" IsOn="True" Header="Timer basse latence (0,5 ms)" OffContent="Désactivé" OnContent="Actif"/><TextBlock Text="Augmente la fréquence du minuteur Windows pendant le jeu afin de réduire certaines attentes. Peut légèrement augmenter la consommation CPU et batterie." FontSize="11" Opacity="0.58" TextWrapping="Wrap"/></StackPanel></Border>
                                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ActionRowStyle}"><ToggleSwitch x:Name="GameKeepAwakeToggle" IsOn="True" Header="Empêcher la mise en veille" OffContent="Non" OnContent="Oui"/></Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource SoftGreenBrush}"><FontIcon Glyph="&#xE713;" Foreground="{StaticResource SynapseGreenBrush}"/></Border>
                                                    <StackPanel><TextBlock Text="Gestion des processus" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Applications mises en pause pendant le jeu" FontSize="12" Opacity="0.55"/></StackPanel>
                                                </StackPanel>
                                                <StackPanel x:Name="BoosterRulesPanel" Spacing="6"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource SoftCyanBrush}"><FontIcon Glyph="&#xE945;" Foreground="{StaticResource SynapseCyanBrush}"/></Border>
                                                    <StackPanel><TextBlock Text="Optimisations système" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Réglages avancés indépendants du profil" FontSize="12" Opacity="0.55"/></StackPanel>
                                                </StackPanel>
                                                <StackPanel Spacing="3"><ToggleSwitch x:Name="LowLatencyToggle" Header="Précision du timer à 0,5 ms" OffContent="Désactivée" OnContent="Active" Toggled="LowLatencyToggle_Toggled"/><TextBlock Text="Réduit l’intervalle de planification Windows. À activer seulement pour les jeux sensibles à la latence ; Synapse restaure la valeur ensuite." FontSize="11" Opacity="0.58" TextWrapping="Wrap"/></StackPanel>
                                                <StackPanel Spacing="3"><ToggleSwitch x:Name="TelemetryToggle" Header="Bouclier anti-télémétrie" OffContent="Désactivé" OnContent="Actif" Toggled="TelemetryToggle_Toggled"/><TextBlock Text="Limite des tâches de diagnostic Windows non essentielles. Un point de restauration est créé avant modification." FontSize="11" Opacity="0.58" TextWrapping="Wrap"/></StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="10">
                                            <Grid>
                                                <StackPanel><TextBlock Text="OPTIMISATIONS DU JEU" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" Opacity="0.55"/><TextBlock Text="Réglages graphiques reconnus" Style="{StaticResource SectionTitleStyle}"/></StackPanel>
                                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Relire" Click="RefreshGameTuningsButton_Click"/>
                                                    <Button Content="Restaurer" Click="RestoreGameTuningsButton_Click"/>
                                                    <Button Content="Appliquer" Style="{StaticResource AccentButtonStyle}" Click="ApplyGameTuningsButton_Click"/>
                                                </StackPanel>
                                            </Grid>
                                            <InfoBar x:Name="GameTuningInfo" IsOpen="True" IsClosable="False" Severity="Informational" Title="Détection prudente" Message="Sélectionne un jeu. Synapse proposera uniquement les clés déjà présentes dans un fichier de configuration reconnu."/>
                                            <StackPanel x:Name="GameTuningsPanel" Spacing="8"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="HardwareView" x:Load="False" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Padding="0,0,6,18">
                            <Border Style="{StaticResource HeroCardStyle}" Padding="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#291B6B83" Offset="0"/>
                                        <GradientStop Color="#151A2632" Offset="0.55"/>
                                        <GradientStop Color="#1823C8FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Padding="24">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="MATÉRIEL" Style="{StaticResource EyebrowStyle}"/>
                                        <TextBlock Text="Ton PC, clairement." Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="Charge en temps réel, composants, pilotes, technologies Windows, refroidissement et RGB dans une seule vue." Style="{StaticResource MutedTextStyle}" MaxWidth="760"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                                        <Border CornerRadius="16" Padding="12,6" Background="{StaticResource SoftCyanBrush}">
                                            <TextBlock x:Name="LiveStatusText" Text="● INITIALISATION" Foreground="{StaticResource SynapseCyanBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Button Content="Actualiser le matériel" HorizontalAlignment="Stretch" Click="RefreshHardwareButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <StackPanel><TextBlock Text="SYSTÈME" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" Opacity="0.55"/><TextBlock x:Name="OperatingSystemText" Text="Windows" Style="{StaticResource SectionTitleStyle}"/><TextBlock x:Name="OperatingSystemVersionText" Text="Version en cours de lecture" FontSize="12" Opacity="0.55"/></StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="42" Height="42" CornerRadius="12" Background="{StaticResource SoftCyanBrush}"><FontIcon Glyph="&#xE770;" Foreground="{StaticResource SynapseCyanBrush}" FontSize="21"/></Border>
                                    </Grid>
                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Style="{StaticResource ActionRowStyle}"><StackPanel><TextBlock x:Name="OsBuildText" Text="—" FontWeight="SemiBold"/><TextBlock Text="Build" FontSize="11" Opacity="0.5"/></StackPanel></Border>
                                        <Border Grid.Column="1" Style="{StaticResource ActionRowStyle}"><StackPanel><TextBlock x:Name="OsArchitectureText" Text="—" FontWeight="SemiBold"/><TextBlock Text="Architecture" FontSize="11" Opacity="0.5"/></StackPanel></Border>
                                        <Border Grid.Column="2" Style="{StaticResource ActionRowStyle}"><StackPanel><TextBlock x:Name="ComputerNameText" Text="—" FontWeight="SemiBold"/><TextBlock Text="Nom du PC" FontSize="11" Opacity="0.5"/></StackPanel></Border>
                                        <Border Grid.Column="3" Style="{StaticResource ActionRowStyle}"><StackPanel><TextBlock x:Name="UserNameText" Text="—" FontWeight="SemiBold"/><TextBlock Text="Utilisateur" FontSize="11" Opacity="0.5"/></StackPanel></Border>
                                        <Border Grid.Row="1" Style="{StaticResource ActionRowStyle}"><StackPanel><TextBlock x:Name="InstalledDateText" Text="—" FontWeight="SemiBold"/><TextBlock Text="Installation" FontSize="11" Opacity="0.5"/></StackPanel></Border>
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ActionRowStyle}"><StackPanel><TextBlock x:Name="SystemUptimeText" Text="—" FontWeight="SemiBold"/><TextBlock Text="Temps de fonctionnement" FontSize="11" Opacity="0.5"/></StackPanel></Border>
                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionRowStyle}"><StackPanel><TextBlock x:Name="BootModeText" Text="—" FontWeight="SemiBold"/><TextBlock Text="Mode de démarrage" FontSize="11" Opacity="0.5"/></StackPanel></Border>
                                        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource ActionRowStyle}"><StackPanel><TextBlock x:Name="TpmVersionText" Text="—" FontWeight="SemiBold"/><TextBlock Text="Version TPM" FontSize="11" Opacity="0.5"/></StackPanel></Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel Spacing="7"><FontIcon Glyph="&#xE950;" Foreground="{StaticResource SynapseCyanBrush}" HorizontalAlignment="Left"/><TextBlock Text="PROCESSEUR" FontSize="11" Opacity="0.55"/><TextBlock x:Name="CpuValue" Text="—" FontSize="30" FontWeight="SemiBold"/><ProgressBar x:Name="CpuBar" Maximum="100" Foreground="{StaticResource SynapseCyanBrush}"/><TextBlock x:Name="CpuTemperatureText" Text="Température non publiée" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis"/></StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel Spacing="7"><FontIcon Glyph="&#xE964;" Foreground="{StaticResource SynapseGreenBrush}" HorizontalAlignment="Left"/><TextBlock Text="MÉMOIRE" FontSize="11" Opacity="0.55"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="30" FontWeight="SemiBold"/><ProgressBar x:Name="MemoryBar" Maximum="100" Foreground="{StaticResource SynapseGreenBrush}"/><TextBlock Text="Mémoire physique utilisée" FontSize="11" Opacity="0.5"/></StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
