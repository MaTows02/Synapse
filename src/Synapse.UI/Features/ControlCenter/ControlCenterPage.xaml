                                <Grid Padding="0,12,4,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,10"><StackPanel><TextBlock Text="PROCESSUS ACTIFS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" Opacity="0.55"/><TextBlock x:Name="ProcessCountText" Text="Chargement…" Style="{StaticResource SectionTitleStyle}"/></StackPanel></Grid><Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0"><ListView x:Name="TaskProcessesList" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate x:DataType="models:TaskProcessInfo"><Grid Padding="12" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><controls:ExecutableIcon ExecutablePath="{x:Bind ExecutablePath}" Width="40" Height="40"/><StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Description}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind Id}" VerticalAlignment="Center" Opacity="0.65"/><TextBlock Grid.Column="3" Text="{x:Bind MemoryDisplay}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{x:Bind Status}" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border><Grid Grid.Row="2" Margin="0,10,0,0"><TextBlock x:Name="TaskManagerStatusText" Text="Sélectionne un processus pour afficher les actions disponibles." VerticalAlignment="Center" Opacity="0.6"/><Button Content="Terminer la tâche" HorizontalAlignment="Right" Click="EndTaskButton_Click"/></Grid></Grid>
                            </TabViewItem>
                            <TabViewItem Header="Applications">
                                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,12,4,4"><ListView x:Name="TaskApplicationsList" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate x:DataType="models:InstalledApplication"><Grid Padding="12" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><controls:ExecutableIcon ExecutablePath="{x:Bind IconPath}" Width="40" Height="40"/><StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Publisher}" FontSize="11" Opacity="0.5"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind Version}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{x:Bind Importance}" VerticalAlignment="Center" Foreground="{StaticResource SynapseGreenBrush}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
                            </TabViewItem>
                            <TabViewItem Header="Démarrage">
                                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,12,4,4"><ListView x:Name="StartupItemsList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:StartupItemInfo"><Grid Padding="12" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><controls:ExecutableIcon ExecutablePath="{x:Bind ExecutablePath}" Width="40" Height="40"/><StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Command}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind Source}" VerticalAlignment="Center"/><Border Grid.Column="3" CornerRadius="11" Padding="8,4" Background="{StaticResource SoftAmberBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{x:Bind Impact}" FontSize="11"/></Border><ToggleSwitch Grid.Column="4" IsOn="{x:Bind IsEnabled}" IsEnabled="{x:Bind CanConfigure}" Tag="{x:Bind}" Toggled="StartupItemToggle_Toggled" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
                            </TabViewItem>
                            <TabViewItem Header="Services">
                                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,12,4,4"><ListView x:Name="WindowsServicesList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:WindowsServiceInfo"><Grid Padding="12" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource SoftCyanBrush}"><FontIcon Glyph="&#xE713;" Foreground="{StaticResource SynapseCyanBrush}"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Description}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind ProcessId}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{x:Bind StartMode}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{x:Bind State}" VerticalAlignment="Center" Foreground="{StaticResource SynapseGreenBrush}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
                            </TabViewItem>
                        </TabView>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
