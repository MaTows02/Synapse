<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Synapse.UI.Features.ControlCenter.ControlCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Synapse.Core.Features.ControlCenter.Models"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="MinWidth" Value="190"/>
        </Style>
        <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource MetricCardStyle}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Page.Resources>

    <Grid Padding="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SYNAPSE" FontSize="28" FontWeight="Bold" CharacterSpacing="180"/>
                <TextBlock Text="by MaTows · Centre de contrôle intelligent Windows" Opacity="0.68" FontSize="14"/>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="16" Padding="12,6" Background="#2523C8FF" VerticalAlignment="Center">
                <TextBlock x:Name="LiveStatusText" Text="● TEMPS RÉEL" Foreground="#FF49D8FF" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <TabView Grid.Row="1" IsAddTabButtonVisible="False">
            <TabViewItem Header="Vue d’ensemble">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Padding="0,12,6,18">
                        <ItemsControl>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Items>
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,12">
                                    <StackPanel Spacing="8"><TextBlock Text="PROCESSEUR" Opacity="0.65"/><TextBlock x:Name="CpuValue" Text="—" FontSize="30" FontWeight="SemiBold"/><ProgressBar x:Name="CpuBar" Maximum="100"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,12">
                                    <StackPanel Spacing="8"><TextBlock Text="MÉMOIRE" Opacity="0.65"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="30" FontWeight="SemiBold"/><ProgressBar x:Name="MemoryBar" Maximum="100"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,12">
                                    <StackPanel Spacing="8"><TextBlock Text="CARTE GRAPHIQUE" Opacity="0.65"/><TextBlock x:Name="GpuValue" Text="—" FontSize="30" FontWeight="SemiBold"/><ProgressBar x:Name="GpuBar" Maximum="100"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,12">
                                    <StackPanel Spacing="8"><TextBlock Text="DISQUE" Opacity="0.65"/><TextBlock x:Name="DiskValue" Text="—" FontSize="30" FontWeight="SemiBold"/><ProgressBar x:Name="DiskBar" Maximum="100"/></StackPanel>
                                </Border>
                            </ItemsControl.Items>
                        </ItemsControl>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Mode performances" FontSize="18" FontWeight="SemiBold"/>
                                    <ToggleSwitch x:Name="LowLatencyToggle" Header="Précision du timer noyau à 0,5 ms" Toggled="LowLatencyToggle_Toggled"/>
                                    <ToggleSwitch x:Name="TelemetryToggle" Header="Bouclier anti-télémétrie Windows" Toggled="TelemetryToggle_Toggled"/>
                                    <TextBlock Text="Les valeurs réellement accordées par Windows sont vérifiées. Chaque modification sensible peut créer un point de restauration." TextWrapping="Wrap" Opacity="0.65"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Ventilateurs &amp; RGB" FontSize="18" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="DevicePicker" PlaceholderText="Contrôleur détecté" DisplayMemberPath="Name" SelectionChanged="DevicePicker_SelectionChanged"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Slider x:Name="FanSlider" Header="Vitesse permanente" Minimum="0" Maximum="100" Value="50" Width="250" IsEnabled="False"/>
                                        <Button x:Name="ApplyFanButton" Content="Appliquer" VerticalAlignment="Bottom" Click="ApplyFanButton_Click" IsEnabled="False"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <ColorPicker x:Name="RgbPicker" IsColorSpectrumVisible="False" IsColorSliderVisible="False" IsAlphaEnabled="False" IsEnabled="False"/>
                                        <Button x:Name="ApplyRgbButton" Content="Appliquer la couleur" VerticalAlignment="Center" Click="ApplyRgbButton_Click" IsEnabled="False"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DeviceStatusText" Text="Recherche des contrôleurs compatibles…" TextWrapping="Wrap" Opacity="0.7"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <InfoBar x:Name="OverviewInfo" IsOpen="False" IsClosable="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Jeux &amp; Booster">
                <Grid Padding="0,12,6,18" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Game Booster adaptatif" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Détection Steam, Epic et jeux enregistrés. Aucun processus critique n’est suspendu." Opacity="0.65"/></StackPanel>
                        <Button Grid.Column="1" Content="Analyser les jeux" Click="ScanGamesButton_Click"/>
                    </Grid>
                    <ListView x:Name="GamesList" Grid.Row="1" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DetectedGame">
                                <Grid Padding="10" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ExecutablePath}" Opacity="0.55" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Launcher}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind OptimizationSummary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <TextBlock Text="Processus proposés à suspendre pendant la partie" FontWeight="SemiBold"/>
                        <StackPanel x:Name="BoosterRulesPanel" Orientation="Horizontal" Spacing="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Enregistrer et activer le profil" Click="CreateGameProfileButton_Click"/>
                            <TextBlock x:Name="GameStatusText" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Matériel">
                <Grid Padding="0,12,6,18" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Inventaire matériel sécurisé" FontSize="22" FontWeight="SemiBold"/><Button Content="Actualiser" HorizontalAlignment="Right" Click="RefreshHardwareButton_Click"/></Grid>
                    <ListView x:Name="TechnologiesList" Grid.Row="1" MaxHeight="210">
                        <ListView.ItemTemplate><DataTemplate x:DataType="models:TechnologyStatus"><Grid Padding="8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{x:Bind State}"/><TextBlock Grid.Column="2" Text="{x:Bind Detail}" TextWrapping="Wrap"/></Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <ListView x:Name="HardwareList" Grid.Row="2">
                        <ListView.ItemTemplate><DataTemplate x:DataType="models:HardwareComponent"><Grid Padding="10" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Category}" Opacity="0.65"/><TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{x:Bind Manufacturer}"/><TextBlock Grid.Column="3" Text="{x:Bind DriverVersion}"/></Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Nettoyage profond">
                <ScrollViewer><StackPanel Padding="0,12,6,18" Spacing="12">
                    <TextBlock Text="13 options de nettoyage" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Analyse d’abord, puis supprime uniquement les catégories cochées. Les mots de passe, cookies et documents personnels sont exclus." Opacity="0.65" TextWrapping="Wrap"/>
                    <StackPanel x:Name="CleanupOptionsPanel" Spacing="6"/>
                    <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Analyser" Click="AnalyzeCleanupButton_Click"/><Button Content="Nettoyer avec point de restauration" Click="CleanButton_Click"/><TextBlock x:Name="CleanupStatusText" VerticalAlignment="Center"/></StackPanel>
                    <Border Style="{StaticResource SectionCardStyle}" Margin="0,16,0,0"><StackPanel Spacing="10"><TextBlock Text="Désinstallation profonde" FontSize="18" FontWeight="SemiBold"/><ComboBox x:Name="AppsPicker" DisplayMemberPath="Name" PlaceholderText="Choisir une application"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Analyser les résidus" Click="AnalyzeUninstallButton_Click"/><Button Content="Désinstaller proprement" Click="ExecuteUninstallButton_Click"/></StackPanel><TextBlock x:Name="UninstallStatusText" TextWrapping="Wrap" Opacity="0.7"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Santé système">
                <Grid Padding="0,12,6,18" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock Text="21 diagnostics système" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Stockage, sécurité, pilotes, réseau, températures et stabilité." Opacity="0.65"/></StackPanel><Button Content="Lancer le diagnostic" HorizontalAlignment="Right" Click="RunDiagnosticsButton_Click"/></Grid>
                    <TextBlock x:Name="DiagnosticsSummaryText" Grid.Row="1" FontSize="16" FontWeight="SemiBold"/>
                    <ListView x:Name="DiagnosticsList" Grid.Row="2">
                        <ListView.ItemTemplate><DataTemplate x:DataType="models:DiagnosticCheckResult"><Grid Padding="9" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind State}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{x:Bind Name}"/><TextBlock Grid.Column="2" Text="{x:Bind Summary}" TextWrapping="Wrap"/><TextBlock Grid.Column="3" Text="{x:Bind Recommendation}" Opacity="0.65" TextWrapping="Wrap"/></Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
