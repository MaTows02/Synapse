<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Synapse.UI.Features.Common.Controls.ExecutableIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border x:Name="Fallback" CornerRadius="9" Background="#1835C7F4">
            <FontIcon Glyph="&#xE7FC;" Foreground="#FF35C7F4" FontSize="18"/>
        </Border>
        <Image x:Name="IconImage" Stretch="Uniform" Visibility="Collapsed"/>
    </Grid>
</UserControl>
